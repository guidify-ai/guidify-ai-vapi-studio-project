PORT=9999
DATABASE_URL=postgres://studio:studio@127.0.0.1:15432/studio
PUBLIC_BASE_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app

# Human project identity — yarn ensure-project-identity writes config/project.identity.json
PROJECT_NAME=Vapi Studio Project
# Optional; defaults to a slugified PROJECT_NAME
PROJECT_SLUG=vapi-studio-project

POC_BRAIN_PROFILE=default
OPENAI_API_KEY=

# ─── Guidify ecosystem auth (one keyring to rule them all) ───
# Vapi Studio — and every sibling service in the Guidify constellation — speaks a
# single authorization dialect: present these Application credentials to the
# tenants service, receive a short-lived JWT, and that token unlocks only the
# surfaces your Application is entitled to (analytics:write, telephony, …).
# Mint client_id / client_secret in vapi-studio-tenants; leave empty until then.
VAPI_STUDIO_CLIENT_ID=
VAPI_STUDIO_CLIENT_SECRET=

# Vapi (optional until you place live calls)
# VAPI_API_KEY=
# VAPI_PHONE_NUMBER_ID=
# POC_ASSISTANT_ID=
# VAPI_END_CALL_TOOL_NAME=end_call_tool
# VAPI_TRANSFER_DESTINATION=
# VAPI_WEBHOOK_SECRET=
LOG_DIR=logs
LOG_DAYS=14
