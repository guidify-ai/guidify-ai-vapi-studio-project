PORT=9999
DATABASE_URL=postgres://studio:studio@127.0.0.1:15432/studio
PUBLIC_BASE_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app

# Human project identity — yarn ensure-project-identity writes config/project.identity.json
PROJECT_NAME=Vapi Studio Project
# Optional; defaults to a slugified PROJECT_NAME
PROJECT_SLUG=vapi-studio-project

POC_BRAIN_PROFILE=default
OPENAI_API_KEY=

# ─── Guidify ecosystem auth (one keyring to rule them all) ───
# Vapi Studio — and every sibling service in the Guidify constellation — speaks a
# single authorization dialect: present these Application credentials to the
# tenants service, receive a short-lived JWT, and that token unlocks only the
# surfaces your Application is entitled to (analytics:write, telephony, …).
# Mint client_id / client_secret in vapi-studio-tenants; leave empty until then.
VAPI_STUDIO_CLIENT_ID=
VAPI_STUDIO_CLIENT_SECRET=

# ─── Vapi (REQUIRED for live voice) ───
# Client must have a Vapi account / org access. Empty keys = must fill before dial.
VAPI_API_KEY=
# Imported phone number UUID in Vapi (must belong to the Twilio account below).
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_NUMBER=
VAPI_PHONE_NUMBER_READABLE=
POC_ASSISTANT_ID=
# POC_ASSISTANT_ID_AB=
VAPI_END_CALL_TOOL_NAME=end_call_tool
VAPI_TRANSFER_DESTINATION=
# VAPI_WEBHOOK_SECRET=

# ─── Twilio (REQUIRED for live voice — Twilio only for now) ───
# Vapi supports more carriers later; this starter currently assumes Twilio.
# The FROM number in Vapi must be imported from THIS Twilio account.
# Trust Hub: profile must allow redirect / outbound to +1 destinations
# (Twilio is strict — unverified geo / trial often fails with
# "Account not allowed to call +1…").
# Balance: keep funds on the account. We recommend ~$30 with auto-recharge
# back to $30 when balance reaches ~$10 (adjust to taste).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER_SID=
TWILIO_SMS_DRY_RUN=1

LOG_DIR=logs
LOG_DAYS=14
